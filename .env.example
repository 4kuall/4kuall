# The Oracle's mind (required) — https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional overrides
# ORACLE_MODEL=claude-opus-5-5
# ORACLE_EFFORT=medium        # low | medium | high — deeper = slower, wiser
# MEMORY_MODEL=claude-opus-5-5

# The Oracle's voice (optional; falls back to the browser's built-in voice)
ELEVENLABS_API_KEY=
# Suggested from the ElevenLabs voice library: "Atlas – The Epic Voice" (deep, "voice of God" style).
# Alternative warm elder: "Sam – Engaging Resonant Storyteller" = hoHSPxhn5hdx2OqGUWcL
# Library voices may need "Add to My Voices" in ElevenLabs before the API can use them.
ELEVENLABS_VOICE_ID=zfWx5IjUaWGWTId9hv9t
# ELEVENLABS_MODEL=eleven_multilingual_v2
# ELEVENLABS_STT_MODEL=scribe_v1

# Semantic search (Hugging Face all-MiniLM-L6-v2, runs locally; ~23 MB download on first use)
# SEMANTIC_SEARCH=off
# EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Set this if you host it publicly, then enter the same value in Settings.
ACCESS_TOKEN=
PORT=3333
