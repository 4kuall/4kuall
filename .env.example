# The Oracle's mind (required) — https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional overrides
# ORACLE_MODEL=claude-opus-5-5
# ORACLE_EFFORT=medium        # low | medium | high — deeper = slower, wiser
# MEMORY_MODEL=claude-opus-5-5

# The Oracle's voice (optional; falls back to the browser's built-in voice)
ELEVENLABS_API_KEY=
# "Bill – Wise, Mature, Balanced" (built into every ElevenLabs account).
# Want the deep "Atlas – The Epic Voice" instead? Add it to My Voices in ElevenLabs first, then use zfWx5IjUaWGWTId9hv9t.
ELEVENLABS_VOICE_ID=pqHfZKP75CvOlQylNhV4
# Live real-time conversation: the "Oracle of the Third Eye" agent already created in your ElevenLabs account
# (Eleven v4 Turbo voice, Claude brain, private: only this server can start sessions).
ELEVENLABS_AGENT_ID=agent_4301m4gaggbzf5et5ma61brmra58
# ELEVENLABS_MODEL=eleven_multilingual_v2
# ELEVENLABS_STT_MODEL=scribe_v1

# Semantic search (Hugging Face all-MiniLM-L6-v2, runs locally; ~23 MB download on first use)
# SEMANTIC_SEARCH=off
# EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Cloud memory (optional locally, recommended in the cloud): Supabase → Connect →
# "Session pooler" connection string. Tables are created automatically.
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Passcode for the app. Required when hosted publicly (you type it once on each device).
ACCESS_TOKEN=
PORT=3333
